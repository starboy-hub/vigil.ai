{
  "manifest_version": 3,
  "key": "",
  "name": "Vigil AI: Universal AI Privacy Shield",
  "version": "1.0.0",
  "description": "Open-source endpoint DLP & zero-trust sentinel. Intercepts and redacts PII before it reaches AI platforms. 100% local.",
  "permissions": ["activeTab", "storage", "contextMenus", "offscreen", "sidePanel", "nativeMessaging", "alarms", "idle"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["vigil-shared.js", "adversarial-normalizer.js", "vigil-vault.js", "fake-data.js", "redos-engine.js", "detection-engine.js", "secret-engine.js", "wasm-simd-fft.js", "vision-canary.js", "vision-firewall.js", "swarm-mesh.js", "webgpu-engine.js", "sentinel-engine.js", "injection-engine.js", "webmail-profile.js", "semantic-engine.js", "leakage-detector.js", "content.js"], "run_at": "document_end",
   "all_frames": true }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
