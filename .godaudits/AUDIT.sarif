      "properties": {
        "grade_method": "static-read",
        "grade_scope": "an arithmetic roll-up of model-assigned pass/fail from a source read, not a test result, scan, or certification",
        "confidence_basis": "Result confidence is the auditor's own label from a source read, not a measured detection rate."
