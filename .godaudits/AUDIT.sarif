      "results": [
        {
          "ruleId": "A-REPO-1",
          "level": "note",
          "message": {
            "text": "F-REPO-1: Repository working directory carries unstaged local modifications. Uncommitted diffs in content.js and release manifest can produce non-reproducible build outputs across developer environments."
          },
          "properties": {
