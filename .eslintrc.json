{
  "root": true,
  "env": {
    "browser": true,
    "worker": true,
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "globals": {
    "chrome": "readonly",
    "VIGIL": "readonly",
    "VIGIL_ENGINE": "readonly",
    "VIGIL_FAKE": "readonly",
    "VIGIL_VAULT": "readonly",
    "VIGIL_SENTINEL": "readonly",
    "VIGIL_INJECTION": "readonly",
    "VIGIL_WEBMAIL": "readonly",
    "VIGIL_REALITY": "readonly",
    "VIGIL_SIGNING": "readonly",
    "VIGIL_THREATS": "readonly",
    "VIGIL_SEMANTIC": "readonly",
    "VIGIL_SECRETS": "readonly",
    "VIGIL_VISION": "readonly",
    "VIGIL_VISION_CANARY": "readonly",
    "VIGIL_VISION_FIREWALL": "readonly",
    "VIGIL_WASM_SIMD_FFT": "readonly",
    "VIGIL_SWARM_MESH": "readonly",
    "VIGIL_WEBGPU": "readonly",
    "VIGIL_VOICE_SPECTRAL": "readonly",
    "VIGIL_ENTERPRISE": "readonly",
    "VIGIL_SIEM": "readonly",
    "VIGIL_NATIVE_BRIDGE": "readonly",
    "VIGIL_SHOPPING": "readonly",
    "VIGIL_DRIFT": "readonly",
    "VIGIL_CONSENSUS": "readonly",
    "VIGIL_INTEGRITY": "readonly",
    "VIGIL_FORENSICS": "readonly",
    "forensicsReplayEngine": "readonly",
    "VIGIL_REDOS": "readonly",
    "VIGIL_LEAKAGE": "readonly",
    "VIGIL_ZK": "readonly",
    "VIGIL_PROMPT_GIT": "readonly",
    "VIGIL_LORA": "readonly",
    "VIGIL_REDTEAM": "readonly",
    "VIGIL_NORMALIZER": "readonly",
    "VIGIL_PHASH": "readonly",
    "TokenBudgetModule": "readonly",
    "ComputeBoundaryModule": "readonly",
    "integrityClient": "readonly",
    "tokenBudgetManager": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-console": "off",
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "semi": [
      "error",
      "always"
    ],
    "quotes": [
      "warn",
      "single"
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/"
  ],
  "overrides": [
    {
      "files": [
        "src/background/offscreen.js"
      ],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
